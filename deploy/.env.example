# 必填：长随机串，例如 openssl rand -hex 24
PM_TOKEN=change-me-to-a-long-random-string

# 可选：NAS 上映射的端口
PM_PORT=8787

# 必填：你的 roadmap 数据仓（my-roadmap）在 NAS 上的路径
# iteration-hub 只是服务仓，不存放生产数据。
# 例如 Synology: /volume1/docker/my-roadmap
ROADMAP=/volume1/docker/my-roadmap

# 必填：pm-wish 的 SSH deploy key 目录（放 id_ed25519 和 known_hosts）
# 该目录会只读挂载到容器的 /ssh
PM_SSH_DIR=/volume1/docker/pm-ssh

# 必填：NAS 上的多媒体/大文件共享目录（SMB 共享，不进 git）
# 例如 fnOS: /vol1/1000/pm-assets
ASSETS_DIR=/vol1/1000/pm-assets

# 可选：对外 CDN / Nginx / R2 基地址；留空则返回 /api/assets/<id>
ASSET_BASE_URL=
# 可选：单文件上限（MB）
ASSET_MAX_MB=50

# 可选：容器以 NAS 用户运行，避免 /data 文件变成 root 所有
# 在 NAS 上执行 id -u / id -g 得到
PUID=1000
PGID=1000

# git commit 作者（pm-wish 的提交记录）
GIT_NAME=your-name
GIT_EMAIL=you@example.com

# 可选：启动时自动配置 origin（SSH deploy key）
# 例如 git@github.com:<your-org>/<your-roadmap>.git
GIT_REMOTE=git@github.com:<your-org>/<your-roadmap>.git
# 可选：fs（默认）或 s3（MinIO/R2/S3；需要 boto3）
ASSET_STORE=fs
# s3 配置（ASSET_STORE=s3 时填写）
ASSET_S3_BUCKET=
ASSET_S3_ENDPOINT=
ASSET_S3_REGION=us-east-1
ASSET_S3_PREFIX=
ASSET_S3_ACCESS_KEY=
ASSET_S3_SECRET_KEY=
# s3 私有桶：没有 CDN 时打开签名 URL
ASSET_SIGNED_URLS=0
ASSET_SIGNED_TTL=3600
# s3 模式构建时安装 boto3
INSTALL_S3=0
